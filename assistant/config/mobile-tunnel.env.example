# Copy to secrets/mobile-tunnel.env (chmod 600).

NGROK_AUTHTOKEN=

# NOMAD (leave alone — already on :8080)
NOMAD_NGROK_URL=https://your-nomad-subdomain.ngrok-free.dev
NOMAD_LOCAL_PORT=8080

# Assistant reserved URL (optional). MUST NOT be the same as NOMAD_NGROK_URL.
# Leave empty: script prints a new random URL for :9241 (second ngrok on :4041).
# NGROK_URL=https://your-assistant-subdomain.ngrok-free.dev

NGROK_TRAFFIC_POLICY_FILE=config/tp.yml

# ngrok local inspector when NOMAD uses 4040 (default: auto → 4041)
# NGROK_WEB_PORT=4041
